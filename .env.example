# Copy values into your shell; do not commit a .env file.
SPENDPILOT_MODE=live
REAP_BASE_URL=https://sg.sandbox.api.reap.global
REAP_API_KEY=
REAP_VERSION=2025-02-14
REAP_ENROLLMENT_ID=
REAP_MERCHANT_KEY=
# Live Reap needs the HTTPS tunnel host relayed by scripts.callback_relay.
REAP_RETURN_URL=https://YOUR_TUNNEL_HOST/payment/return
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Required only when Reap marks the selected candidate as shipping-required.
SPENDPILOT_SHIPPING_ADDRESS_JSON=
REAP_TRUSTED_OWNER_ID=
SPENDPILOT_CHECKOUT_CAP_MINOR=10000
SPENDPILOT_RUN_CAP_MINOR=20000
# Optional separate database; never replace one with uncertain live attempts.
# SPENDPILOT_DB_PATH=spendpilot-live.db
